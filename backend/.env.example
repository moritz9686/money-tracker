# Backend-specific example configuration. Do not place credentials in this file.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Keep this file credential-free. See the root .env.example for all database
# configuration and copy the values to your local, ignored .env file.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
