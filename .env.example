# Copy to .env only when you need local overrides. Never commit real values.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Supabase PostgreSQL. Use the Transaction pooler URI from the Supabase Connect
# panel and change its scheme to postgresql+psycopg://. This is a placeholder,
# not a usable credential.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Keep the application-side pool deliberately small; Supabase manages the
# database-side pool. Use integer values only.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
