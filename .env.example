# Copy to .env only when you need local overrides. Never commit real values.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Supabase PostgreSQL. Use the Transaction pooler URI from the Supabase Connect
# panel and change its scheme to postgresql+psycopg://. This is a placeholder,
# not a usable credential.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Keep the application-side pool deliberately small; Supabase manages the
# database-side pool. Use integer values only.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Gmail OAuth: backend only. Create these in Google Cloud and place real values
# only in your ignored local .env or cloud-host secret manager. Never Flutter.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GMAIL_OAUTH_STATE_SECRET=

# Production web clients only; use exact comma-separated HTTPS origins.
CORS_ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
API_DOCS_ENABLED=false
