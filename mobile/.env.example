# Documentation only: Flutter does not load .env files by default.
# Supply this non-secret URL with --dart-define=API_BASE_URL=... at build/run time.
# Do not add database credentials, OAuth secrets, banking credentials, or real data.
API_BASE_URL=https://api.example.com

# Optional temporary development scope for the current backend only.
# Supply with --dart-define=API_DEVELOPMENT_USER_ID=<UUID>; never use this as auth.
API_DEVELOPMENT_USER_ID=
